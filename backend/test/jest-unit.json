{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "./unit",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": ["../../src/**/*.(t|j)s"],
  "coverageDirectory": "../../coverage",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../../src/$1"
  }
}
