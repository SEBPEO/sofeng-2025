{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "./integration",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "isolatedModules": true,
      "tsconfig": {
        "noImplicitAny": false,
        "strict": false,
        "skipLibCheck": true
      }
    }]
  },
  "globals": {
    "ts-jest": {
      "isolatedModules": true
    }
  }
}
