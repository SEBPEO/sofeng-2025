
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")       
}

model User{
    user_id              String      @id @default(uuid())
    first_name           String      @db.VarChar(200)
    last_name            String      @db.VarChar(200)
    gender               Gender
    email                String      @unique @db.VarChar(200)
    role                 Role 
    createdAt            DateTime    @default(now())
    lastLogin            DateTime?
    
    sentMessages        Chat[]      @relation("SentMessages")
    receivedMessages    Chat[]      @relation("ReceivedMessages")
    doctor_profile      DoctorProfile?
    patient_profile     PatientProfile?
    notifications       Notification[]
    notificationPreferences NotificationPreferences?
    auditLogs           AuditLog[]
    
}

model Chat{
    message_id      Int         @id @default(autoincrement())
    sender_id       String
    receiver_id     String
    content         String      @db.Text
    sent_at         DateTime    @default(now())
    read_at         DateTime?
    file_path       String?     @db.VarChar(500)
    file_name       String?     @db.VarChar(255)
    file_type       String?     @db.VarChar(100)
    file_size       Int?

    sender      User    @relation("SentMessages", fields: [sender_id], references: [user_id], onDelete: Cascade)
    receiver    User    @relation("ReceivedMessages", fields: [receiver_id], references: [user_id], onDelete: Cascade)

    @@index([sender_id, receiver_id])
    @@index([receiver_id])
    @@index([sent_at])
}

model DoctorProfile{
    doctor_id           Int      @id
    user_id             String      @unique
    specialization      String   @db.VarChar(150)
    experience_years    Int?
    clinic_address      String   @db.VarChar(200)
    contact_info        String?  @db.VarChar(200)
    working_hours       String?  @db.VarChar(100)

    user            User          @relation(fields: [user_id], references: [user_id])
    appointments    Appointment[]
    patients        DoctorPatient[] @relation("DoctorToPatient")
    availability    Availability[]

}

model PatientProfile{
    patient_id          Int         @id
    user_id             String      @unique
    date_of_birth       DateTime?
    emergency_contact   String?     @db.VarChar(200)
    conditions          String?
    medications         String?
    allergy             String?

    user            User          @relation(fields: [user_id], references: [user_id])
    appointments    Appointment[]
    doctors         DoctorPatient[] @relation("PatientToDoctor")
}

model Appointment {
    appointment_id           Int       @id
    doctor_id                Int
    patient_id               Int
    appointment_datetime     DateTime
    duration_minutes         Int?
    status                   AppointmentStatus
    notes                    String?
    patient_consent_to_record Boolean   @default(false)
    proposed_appointment_datetime DateTime?
    reschedule_note          String?

    doctor          DoctorProfile @relation(fields: [doctor_id], references: [doctor_id])
    patient         PatientProfile @relation(fields: [patient_id], references: [patient_id])
    consultation    Consultation?
}

model Consultation {
    consultation_id     Int         @id
    appointment_id      Int         @unique
    created_at          DateTime?
    diagnosis           String?  
    treatment_plan      String?  
    recording           String?     @db.VarChar(200)
    transcript          String?  
    AI_summary          String? 
    notes_approved_at   DateTime?
    notes_approved_by   String?
    notes_locked        Boolean     @default(false)
    notes_status        NotesStatus @default(DRAFT)

    appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])

    recordings ConsultationRecording[]
    actionItems ConsultationActionItem[]

}

model ConsultationRecording {
    consultation_recording_id Int      @id @default(autoincrement())
    consultation_id           Int
    file_path                 String   @db.VarChar(300)
    created_at                DateTime @default(now())

    consultation Consultation @relation(fields: [consultation_id], references: [consultation_id], onDelete: Cascade)

    @@index([consultation_id])
}

model ConsultationActionItem {
    action_item_id     Int       @id @default(autoincrement())
    consultation_id    Int
    description        String    @db.Text
    is_completed       Boolean   @default(false)
    created_at         DateTime  @default(now())
    updated_at         DateTime  @updatedAt

    consultation Consultation @relation(fields: [consultation_id], references: [consultation_id], onDelete: Cascade)

    @@index([consultation_id])
    @@index([consultation_id, is_completed])
}

model DoctorPatient {
    id              Int         @id @default(autoincrement())
    doctor_id       Int
    patient_id      Int
    assigned_at     DateTime    @default(now())

    doctor          DoctorProfile @relation("DoctorToPatient", fields: [doctor_id], references: [doctor_id], onDelete: Cascade)
    patient         PatientProfile @relation("PatientToDoctor", fields: [patient_id], references: [patient_id], onDelete: Cascade)

    @@unique([doctor_id, patient_id])
}

enum Role {
    doctor
    patient
}

enum Gender {
    male
    female
}

enum AppointmentStatus {
    scheduled
    pending_reschedule
    completed
    cancelled
}

enum NotesStatus {
    DRAFT
    APPROVED
    FINAL
}

model Availability {
    availability_id     Int      @id @default(autoincrement())
    doctor_id           Int
    day_of_week         Int      // 0-6 for Sunday-Saturday
    start_time          String   @db.VarChar(5) // Format "HH:mm"
    end_time            String   @db.VarChar(5) // Format "HH:mm"
    duration_minutes    Int      // Default appointment duration for this day
    is_available        Boolean  @default(true)

    doctor              DoctorProfile @relation(fields: [doctor_id], references: [doctor_id], onDelete: Cascade)

    @@unique([doctor_id, day_of_week])
}

model NotificationPreferences {
    id                          Int      @id @default(autoincrement())
    user_id                     String   @unique
    
    // Email notifications
    email_enabled               Boolean  @default(true)
    email_unread_messages       Boolean  @default(true)
    email_appointments          Boolean  @default(true)
    
    // Push notifications
    push_enabled                Boolean  @default(true)
    push_messages               Boolean  @default(true)
    push_appointments           Boolean  @default(true)
    
    // In-app notifications
    in_app_enabled              Boolean  @default(true)
    in_app_messages             Boolean  @default(true)
    in_app_appointments         Boolean  @default(true)
    
    // Appointment reminder timing (in minutes before appointment)
    reminder_time_1             Int      @default(1440) // 1 day = 1440 minutes
    reminder_time_2             Int      @default(60)   // 1 hour = 60 minutes
    
    created_at                  DateTime @default(now())
    updated_at                  DateTime @updatedAt
    
    user                        User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Notification {
    notification_id     Int              @id @default(autoincrement())
    user_id             String
    type                NotificationType
    title               String           @db.VarChar(200)
    message             String           @db.Text
    related_id          String?          // Can be appointment_id, message_id, etc.
    is_read             Boolean          @default(false)
    created_at          DateTime         @default(now())
    read_at             DateTime?
    
    user                User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
    
    @@index([user_id, is_read])
    @@index([created_at])
}

enum NotificationType {
    MESSAGE
    APPOINTMENT_REMINDER
    APPOINTMENT_SCHEDULED
    APPOINTMENT_CANCELLED
    APPOINTMENT_RESCHEDULED
}

model AuditLog {
    audit_id        Int         @id @default(autoincrement())
    user_id         String?     
    action          AuditAction
    resource_type   String      @db.VarChar(100) // "Appointment", "Consultation", "Chat"
    resource_id     String?     @db.VarChar(100) // ID of the resource affected
    details         String?     @db.Text        
    ip_address      String?     @db.VarChar(45) // IPv4 or IPv6
    user_agent      String?     @db.VarChar(500)
    created_at      DateTime    @default(now())
    
    user            User?       @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
    
    @@index([user_id, created_at])
    @@index([resource_type, resource_id])
    @@index([action])
    @@index([created_at])
}

enum AuditAction {
    // Authentication and Access
    LOGIN
    LOGOUT
    LOGIN_FAILED
    
    // Data Operations
    CREATE
    READ
    UPDATE
    DELETE
    
    // File & Recording Operations
    RECORDING_UPLOAD
    RECORDING_DOWNLOAD
    RECORDING_ACCESS
    RECORDING_DELETE
    FILE_UPLOAD
    FILE_DOWNLOAD
    FILE_ACCESS
    FILE_DELETE
    
    // Sharing & Permissions
    SHARE
    UNSHARE
    PERMISSION_CHANGE
    
    // Medical Records
    CONSULTATION_VIEW
    CONSULTATION_EDIT
    MEDICAL_RECORD_ACCESS
    PRESCRIPTION_VIEW
    
    // Communication
    MESSAGE_SENT
    MESSAGE_READ
    
    // System Events
    SYSTEM_ERROR
    SECURITY_ALERT
}
