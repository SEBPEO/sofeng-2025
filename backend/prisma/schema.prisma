
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")       
}

model User{
    user_id              String      @id @default(uuid())
    first_name           String      @db.VarChar(200)
    last_name            String      @db.VarChar(200)
    gender               Gender
    email                String      @unique @db.VarChar(200)
    role                 Role 
    createdAt            DateTime    @default(now())
    lastLogin            DateTime?
    
    sentMessages        Chat[]      @relation("SentMessages")
    receivedMessages    Chat[]      @relation("ReceivedMessages")
    doctor_profile      DoctorProfile?
    patient_profile     PatientProfile?
    
}

model Chat{
    message_id      Int         @id @default(autoincrement())
    sender_id       String
    receiver_id     String
    content         String      @db.Text
    sent_at         DateTime    @default(now())
    read_at         DateTime?
    file_path       String?     @db.VarChar(500)
    file_name       String?     @db.VarChar(255)
    file_type       String?     @db.VarChar(100)
    file_size       Int?

    sender      User    @relation("SentMessages", fields: [sender_id], references: [user_id], onDelete: Cascade)
    receiver    User    @relation("ReceivedMessages", fields: [receiver_id], references: [user_id], onDelete: Cascade)

    @@index([sender_id, receiver_id])
    @@index([receiver_id])
    @@index([sent_at])
}

model DoctorProfile{
    doctor_id           Int      @id
    user_id             String      @unique
    specialization      String   @db.VarChar(150)
    experience_years    Int?
    clinic_address      String   @db.VarChar(200)
    contact_info        String?  @db.VarChar(200)
    working_hours       String?  @db.VarChar(100)

    user            User          @relation(fields: [user_id], references: [user_id])
    appointments    Appointment[]
    patients        DoctorPatient[] @relation("DoctorToPatient")
    availability    Availability[]

}

model PatientProfile{
    patient_id          Int         @id
    user_id             String      @unique
    date_of_birth       DateTime?
    emergency_contact   String?     @db.VarChar(200)
    conditions          String?
    medications         String?
    allergy             String?

    user            User          @relation(fields: [user_id], references: [user_id])
    appointments    Appointment[]
    doctors         DoctorPatient[] @relation("PatientToDoctor")
}

model Appointment {
    appointment_id           Int       @id
    doctor_id                Int
    patient_id               Int
    appointment_datetime     DateTime
    duration_minutes         Int?
    status                   AppointmentStatus
    notes                    String?
    patient_consent_to_record Boolean   @default(false)
    proposed_appointment_datetime DateTime?
    reschedule_note          String?

    doctor          DoctorProfile @relation(fields: [doctor_id], references: [doctor_id])
    patient         PatientProfile @relation(fields: [patient_id], references: [patient_id])
    consultation    Consultation?
}

model Consultation {
    consultation_id     Int         @id
    appointment_id      Int         @unique
    created_at          DateTime?
    diagnosis           String?  
    treatment_plan      String?  
    recording           String?     @db.VarChar(200)
    transcript          String?  
    AI_summary          String? 

    appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])

    recordings ConsultationRecording[]

}

model ConsultationRecording {
    consultation_recording_id Int      @id @default(autoincrement())
    consultation_id           Int
    file_path                 String   @db.VarChar(300)
    created_at                DateTime @default(now())

    consultation Consultation @relation(fields: [consultation_id], references: [consultation_id], onDelete: Cascade)

    @@index([consultation_id])
}

model DoctorPatient {
    id              Int         @id @default(autoincrement())
    doctor_id       Int
    patient_id      Int
    assigned_at     DateTime    @default(now())

    doctor          DoctorProfile @relation("DoctorToPatient", fields: [doctor_id], references: [doctor_id], onDelete: Cascade)
    patient         PatientProfile @relation("PatientToDoctor", fields: [patient_id], references: [patient_id], onDelete: Cascade)

    @@unique([doctor_id, patient_id])
}

enum Role {
    doctor
    patient
}

enum Gender {
    male
    female
}

enum AppointmentStatus {
    scheduled
    pending_reschedule
    completed
    cancelled
}

model Availability {
    availability_id     Int      @id @default(autoincrement())
    doctor_id           Int
    day_of_week         Int      // 0-6 for Sunday-Saturday
    start_time          String   @db.VarChar(5) // Format "HH:mm"
    end_time            String   @db.VarChar(5) // Format "HH:mm"
    duration_minutes    Int      // Default appointment duration for this day
    is_available        Boolean  @default(true)

    doctor              DoctorProfile @relation(fields: [doctor_id], references: [doctor_id], onDelete: Cascade)

    @@unique([doctor_id, day_of_week])
}


