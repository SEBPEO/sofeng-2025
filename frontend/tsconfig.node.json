{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "strict": false,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "include": ["vite.config.js", "vite.config.ts", "vite.config.mjs"]
}
